# Configuração do cliente (Vite). Copie para client/.env.local.
#
# Este arquivo é OPCIONAL. O projeto Firebase continua sendo `mimo-2d6eb` e os
# valores padrão já estão embutidos em client/src/firebase.ts, então a aplicação
# funciona sem nenhum .env.local.
#
# Use este arquivo se precisar apontar para outro projeto (um ambiente de
# testes, por exemplo). Nesse caso preencha os SEIS valores de uma vez: apiKey,
# appId e messagingSenderId são opacos e pertencem a um projeto específico.
# Misturá-los com o projectId de outro projeto faz a autenticação e as regras
# do Firestore falharem de um jeito difícil de diagnosticar.

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=mimo-2d6eb.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=mimo-2d6eb
# VITE_FIREBASE_STORAGE_BUCKET=mimo-2d6eb.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Domínio do handshake OAuth do Firebase Auth. Descomente DEPOIS que
# www.boomii.com.br estiver conectado no Hosting e adicionado em
# Authentication -> Settings -> Authorized domains.
# Isso troca a referência a "mimo" no authDomain pelo domínio próprio.
# (Este projeto usa só e-mail/senha, então o valor é inerte hoje.)
# VITE_FIREBASE_AUTH_DOMAIN=www.boomii.com.br

# URL pública do site institucional. Troque para https://www.boomii.com.br
# quando o domínio estiver com o certificado SSL emitido.
VITE_FIREBASE_HOSTING_URL=https://boomii-fidelidade.web.app

# Host que serve a Área do Lojista. É o .web.app do Firebase — não há domínio
# próprio para ele, por decisão de projeto (um domínio só).
VITE_HOST_AREA_LOJISTA=boomii-fidelidade.web.app
