rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regras da plataforma BOOMII Fidelidade.
    //
    // Antes, TODA coleção era "allow read, write: if true" — qualquer pessoa
    // na internet podia ler e reescrever selos, dados de clientes (PII/LGPD),
    // senhas de lojista e a própria trilha de auditoria. Corrigido: as Cloud
    // Functions (criarCartao/carimbar/resgatar/atualizarPasse/autenticar*)
    // usam o Admin SDK, que ignora estas regras — elas continuam funcionando
    // normalmente. Só o acesso DIRETO do navegador é que passa a ser
    // restringido por sessão (ver autenticarAdmin/autenticarLojista, que
    // emitem um Firebase Auth custom token com claims role/lojaId).

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    function isLojista(lojaId) {
      return request.auth != null
        && request.auth.token.role == 'lojista'
        && request.auth.token.lojaId == lojaId;
    }

    // Gerente de filial: opera o balcão da loja enquanto a unidade dele
    // estiver ativa. Desativar a unidade (ou trocar de plano) corta o acesso.
    function isGerente(lojaId) {
      return request.auth != null
        && request.auth.token.role == 'gerente'
        && request.auth.token.lojaId == lojaId
        && get(/databases/$(database)/documents/lojistas/$(lojaId)/unidades/$(request.auth.token.unidadeId)).data.status == 'ativa';
    }

    // Configuração pública da loja (nome, cores, logo, textos do cartão): a
    // página de cadastro do cliente (/c/{slug}) precisa ler isso sem login,
    // então o read continua público. Escrita só pelo dono ou pelo admin.
    // Campos que só o admin altera. Antes o lojista podia escrever QUALQUER
    // campo da própria loja: pelo console do navegador ele se marcava como
    // adimplente, reativava a loja bloqueada ou até a apagava. `operadores`
    // é legado — os PINs agora vivem em /privado, gravados pelo servidor.
    function alteraCampoDoAdmin() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['financeiro', 'statusFinanceiro', 'ativo', 'email', 'operadores', 'criadoEm',
                 'unidadesResumo', 'designPlanoSuperior', 'layoutPlanoSuperior']);
    }

    match /lojistas/{lojaId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isLojista(lojaId) && !alteraCampoDoAdmin());

      // Clientes cadastrados (nome, celular, e-mail, aniversário — dado
      // pessoal sob LGPD): só o lojista dono ou o admin podem ler. Escrita
      // só pelas Cloud Functions (nunca direto do navegador).
      match /clientes/{clienteId} {
        // O cartão vale na rede toda: o gerente atende clientes de qualquer unidade.
        allow read: if isAdmin() || isLojista(lojaId) || isGerente(lojaId);
        allow write: if false;
      }

      // Unidades: gravadas só pelas Cloud Functions (limite do plano e
      // aprovação do admin). O gerente lê apenas a própria.
      match /unidades/{unidadeId} {
        allow read: if isAdmin() || isLojista(lojaId)
          || (isGerente(lojaId) && request.auth.token.unidadeId == unidadeId);
        allow write: if false;
      }

      // Qualquer outra subcoleção futura sob a loja: mesma regra da doc pai.
      match /{document=**} {
        allow read: if isAdmin() || isLojista(lojaId);
        allow write: if false;
      }
    }

    // Cartões de fidelidade: emitidos e alterados exclusivamente pelas Cloud
    // Functions (criarCartao/carimbar/resgatar/atualizarPasse), nunca por
    // escrita direta do cliente — é o que impedia qualquer visitante de
    // simplesmente setar `selos` para 10 sem passar pelo PIN do operador.
    match /cartoes/{cartaoId} {
      allow read: if isAdmin()
        || (request.auth != null
            && request.auth.token.role == 'lojista'
            && request.auth.token.lojaId == resource.data.lojaId)
        || isGerente(resource.data.lojaId);
      allow write: if false;

      match /eventos/{eventoId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Não utilizada pelo cliente atualmente.
    match /usuarios/{uid} {
      allow read, write: if false;
    }

    match /resgates/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Links de reenvio do cartão: o token É a credencial. Só as Cloud
    // Functions leem e gravam; ninguém lista nem lê pelo navegador.
    match /reenvios/{token} {
      allow read, write: if false;
    }

    // Trilha de auditoria: só o Admin SDK grava; ninguém reescreve.
    match /auditoria/{id} {
      allow read, write: if false;
    }
  }
}
