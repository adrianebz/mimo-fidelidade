rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Antes, "allow write" só checava tamanho/tipo do arquivo — sem exigir
    // login, qualquer pessoa podia sobrescrever o logo/banner de QUALQUER
    // loja (imagens que aparecem dentro dos passes na carteira dos clientes).
    // Hoje o app não escreve mais no Storage (logos/banners viajam como
    // base64 no Firestore e são servidos pelas Cloud Functions getLogo /
    // generateBanner), mas a regra abaixo já deixa a escrita pronta e segura
    // para quando isso for reativado.
    match /lojistas/{lojaId}/{arquivo=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.token.role == 'admin' || request.auth.token.lojaId == lojaId)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
