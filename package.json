{
  "name": "boomii-fidelidade",
  "version": "2.0.0",
  "type": "module",
  "description": "Boomii — Plataforma multiempresa de fidelidade em carteira digital (Apple Wallet & Google Wallet)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "server": "tsx src/server.ts",
    "dev:server": "tsx watch src/server.ts",
    "test": "tsx src/tests/run-all.ts",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "ios:sync": "npm run client:build && npx cap sync ios",
    "ios:creds": "node scripts/gerar_credenciais_ios.cjs",
    "dev": "concurrently \"npm run dev:server\" \"npm run client:dev\""
  },
  "keywords": [
    "loyalty",
    "apple-wallet",
    "google-wallet",
    "pkpass",
    "saas"
  ],
  "author": "Boomii Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "firebase-tools": "^15.29.0",
    "node-forge": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
